# ==============================================================================
# GATEWISE AI — Environment Configuration Template
# Copy this file to .env and configure values before starting development.
# NEVER commit actual .env files, API keys, or private keystores to Git.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database Connection (PostgreSQL with pgvector for production; SQLite fallback for local dev)
DATABASE_URL=postgresql://gatewise:gatewise_secure_password@localhost:5432/gatewise_db
DATABASE_POOL_SIZE=10

# Security & Cryptographic Signing
# Generate random 32+ character secrets using: openssl rand -hex 32
SECRET_KEY=replace-with-secure-32-byte-hex-secret
JWT_SECRET=replace-with-secure-32-byte-hex-secret
SESSION_SECRET=replace-with-secure-32-byte-hex-secret
ENCRYPTION_KEY=replace-with-secure-32-byte-hex-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Google Workspace / Shared Drive Identity Sync (Backend-only)
# NEVER expose Google OAuth Client Secrets to web or mobile clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=IIM_Sambalpur_Approved_Identities_2024_2026

# Gemini Operational Policy AI Assistant (Backend-only text guidance)
# STRICT POLICY: Zero biometric images or facial embeddings are transmitted to Gemini
GEMINI_API_KEY=

# Public Client Endpoint URLs (Safe for frontend exposure)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
