            }
            lines {
              text: "        window.scrollTo(0, p * totalScrollable);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (v) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          try { v.currentTime = t; } catch (e) {}"
