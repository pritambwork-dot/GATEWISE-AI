            }
            lines {
              text: "          if (idx === activeIndex) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            row.classList.add(\'active\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
