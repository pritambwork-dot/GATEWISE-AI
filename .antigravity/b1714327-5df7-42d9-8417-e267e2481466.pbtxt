            }
            lines {
              text: "          const next = pendingTime;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          pendingTime = null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          attemptSeek(next);"
