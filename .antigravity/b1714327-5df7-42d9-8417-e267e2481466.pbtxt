            }
            lines {
              text: "          cueOpacity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          cueOpacity = 1 - (p - 0.04) / (0.12 - 0.04);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scrollCue.style.opacity = cueOpacity;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scrollCue.style.visibility = cueOpacity <= 0.001 ? \'hidden\' : \'visible\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // 3. Process list:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // rises 40px and fades in between p .08 and .24"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        let processOpacity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (p <= 0.08) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          processOpacity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        } else if (p >= 0.24) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          processOpacity = 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          processOpacity = (p - 0.08) / (0.24 - 0.08);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const processTranslateY = (1 - processOpacity) * 40;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        processContainer.style.opacity = processOpacity;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        processContainer.style.transform = `translateY(${processTranslateY}px)`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        processContainer.style.visibility = processOpacity <= 0.001 ? \'hidden\' : \'visible\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Step 01 is active below p .62, and step 02 above it"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const activeIndex = p < 0.62 ? 0 : 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        rows.forEach((row, idx) => {"
