            }
            lines {
              text: "      const prefersReducedMotion = window.matchMedia(\'(prefers-reduced-motion: reduce)\').matches;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Animation loop"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      function onFrame() {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (!isRecorder) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Calculate raw scroll progress"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const rect = track.getBoundingClientRect();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const totalScrollable = track.offsetHeight - window.innerHeight;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const currentScrolled = -rect.top;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const rawP = totalScrollable > 0 ? clamp(currentScrolled / totalScrollable, 0, 1) : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          targetProgress = rawP;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (prefersReducedMotion) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            smoothProgress = targetProgress;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            currentTime = targetProgress * (videoDuration - 1 / 48);"
