  code_action {
    action_spec {
      create_file {
        instruction: "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\">\n  <title>NORVA \342\200\224 The New Standard in Staffing</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300..900;1,300..900&display=swap\" rel=\"stylesheet\">\n  <style>\n    :root {\n      --u: clamp(0.72px, min(calc(100vw / 1440), calc(100vh / 960)), 1.5px);\n      --night: #0f1626;\n      --ink: #f4f6fa;\n      --ink-72: rgba(244, 246, 250, 0.72);\n      --ink-46: rgba(244, 246, 250, 0.46);\n      --pill-grey: #2a3245;\n      --lime: #c6ff2e;\n      --cyan: #3fd8ff;\n      --hairline: rgba(255, 255, 255, 0.22);\n      --vh: 1vh;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n      -webkit-font-smoothing: antialiased;\n      -moz-osx-font-smoothing: grayscale;\n    }\n\n    html, body {\n      background-color: var(--night);\n      color: var(--ink);\n      font-family: \'Inter Tight\', system-ui, -apple-system, sans-serif;\n      overflow-x: hidden;\n      width: 100%;\n      height: auto;\n      scroll-behavior: auto;\n    }\n\n    /* Scroll track */\n    .scroll-track {\n      position: relative;\n      width: 100%;\n      height: 420vh;\n    }\n\n    /* Sticky viewport container */\n    .viewport-stage {\n      position: sticky;\n      top: 0;\n      left: 0;\n      width: 100vw;\n      height: 100vh;\n      height: calc(var(--vh, 1vh) * 100);\n      overflow: hidden;\n      perspective: calc(900 * var(--u));\n      background-color: var(--night);\n    }\n\n    /* Video element */\n    .scene-video {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      pointer-events: none;\n      z-index: 1;\n      will-change: transform;\n    }\n\n    /* Gradient overlay for text legibility */\n    .scene-shade {\n      position: absolute;\n      inset: 0;\n      background: linear-gradient(\n        180deg,\n        rgba(15, 22, 38, 0.55) 0%,\n        rgba(15, 22, 38, 0) 34%,\n        rgba(15, 22, 38, 0) 70%,\n        rgba(15, 22, 38, 0.50) 100%\n      );\n      pointer-events: none;\n      z-index: 2;\n    }\n\n    /* Fixed Navigation */\n    .nav-bar {\n      position: fixed;\n      top: 0;\n      left: 0;\n      right: 0;\n      height: calc(58 * var(--u));\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 calc(36 * var(--u));\n      z-index: 50;\n      pointer-events: auto;\n    }\n\n    .nav-left {\n      display: flex;\n      align-items: center;\n      gap: calc(24 * var(--u));\n      flex: 1;\n    }\n\n    .nav-link {\n      font-size: calc(11.5 * var(--u));\n      font-weight: 600;\n      text-transform: uppercase;\n      letter-spacing: 0.06em;\n      color: var(--ink-72);\n      text-decoration: none;\n      transition: color 0.2s ease;\n      cursor: pointer;\n    }\n\n    .nav-link:hover {\n      color: var(--ink);\n    }\n\n    .nav-center {\n      position: absolute;\n      left: 50%;\n      transform: translateX(-50%);\n      font-size: calc(19 * var(--u));\n      font-weight: 700;\n      letter-spacing: 0.06em;\n      color: var(--ink);\n      text-transform: uppercase;\n      cursor: default;\n    }\n\n    .nav-right {\n      display: flex;\n      align-items: center;\n      gap: calc(12 * var(--u));\n      justify-content: flex-end;\n      flex: 1;\n    }\n\n    .pill-btn {\n      height: calc(40 * var(--u));\n      padding: 0 calc(20 * var(--u));\n      border-radius: 9999px;\n      font-size: calc(11 * var(--u));\n      font-weight: 600;\n      letter-spacing: 0.05em;\n      text-transform: uppercase;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      border: none;\n      cursor: pointer;\n      text-decoration: none;\n      transition: transform 0.15s ease, background-color 0.2s ease, box-shadow 0.2s ease;\n      will-change: transform;\n    }\n\n    .pill-btn:hover {\n      transform: translateY(-1px);\n    }\n\n    .pill-btn.grey {\n      background-color: var(--pill-grey);\n      color: var(--ink);\n    }\n\n    .pill-btn.grey:hover {\n      background-color: #353f57;\n    }\n\n    .pill-btn.lime {\n      background-color: var(--lime);\n      color: var(--night);\n      box-shadow: 0 0 16px rgba(198, 255, 46, 0.2);\n    }\n\n    .pill-btn.lime:hover {\n      background-color: #d2ff4a;\n      box-shadow: 0 0 24px rgba(198, 255, 46, 0.4);\n    }\n\n    /* Hero Copy Section */\n    .hero-stage {\n      position: fixed;\n      top: calc(92 * var(--u));\n      left: 0;\n      right: 0;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      text-align: center;\n      pointer-events: none;\n      z-index: 10;\n      transform-style: preserve-3d;\n      transform-origin: 50% 100%;\n      will-change: transform, opacity;\n    }\n\n    .hero-headline {\n      font-size: calc(84 * var(--u));\n      font-weight: 600;\n      line-height: 0.96;\n      letter-spacing: -0.045em;\n      color: var(--ink);\n      margin-bottom: calc(24 * var(--u));\n      text-shadow: 0 4px 30px rgba(15, 22, 38, 0.8);\n    }\n\n    .hero-subline {\n      font-size: calc(18 * var(--u));\n      font-weight: 400;\n      line-height: 1.45;\n      color: var(--ink-72);\n      max-width: calc(720 * var(--u));\n      text-shadow: 0 2px 14px rgba(15, 22, 38, 0.8);\n    }\n\n    /* Scroll Cue */\n    .scroll-cue {\n      position: fixed;\n      bottom: calc(36 * var(--u));\n      left: 50%;\n      transform: translateX(-50%);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      pointer-events: none;\n      z-index: 20;\n      will-change: opacity;\n    }\n\n    .scroll-cue-text {\n      font-size: calc(11.5 * var(--u));\n      font-weight: 600;\n      text-transform: uppercase;\n      letter-spacing: 0.06em;\n      color: var(--ink-72);\n      margin-bottom: calc(6 * var(--u));\n    }\n\n    .scroll-cue-line-track {\n      width: 100%;\n      height: 1px;\n      background: rgba(255, 255, 255, 0.12);\n      position: relative;\n      overflow: hidden;\n    }\n\n    .scroll-cue-line-fill {\n      position: absolute;\n      top: 0;\n      left: 0;\n      height: 100%;\n      width: 100%;\n      background: var(--ink);\n      transform-origin: left center;\n      will-change: transform;\n    }\n\n    /* Process List (Bottom Left) */\n    .process-container {\n      position: fixed;\n      left: calc(36 * var(--u));\n      bottom: calc(28 * var(--u));\n      width: calc(430 * var(--u));\n      z-index: 25;\n      display: flex;\n      flex-direction: column;\n      gap: calc(12 * var(--u));\n      pointer-events: auto;\n      will-change: transform, opacity;\n    }\n\n    .process-row {\n      display: flex;\n      flex-direction: column;\n      border-radius: calc(10 * var(--u));\n      transition: background-color 0.3s ease;\n      cursor: pointer;\n    }\n\n    .process-header {\n      display: flex;\n      align-items: center;\n      gap: calc(14 * var(--u));\n      padding: calc(6 * var(--u)) 0;\n    }\n\n    .process-num-cell {\n      width: calc(36 * var(--u));\n      height: calc(36 * var(--u));\n      border-radius: calc(8 * var(--u));\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: calc(12.5 * var(--u));\n      font-weight: 600;\n      background: rgba(255, 255, 255, 0.06);\n      border: 1px solid var(--hairline);\n      color: var(--ink-72);\n      transition: background-color 0.35s ease, color 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;\n      flex-shrink: 0;\n    }\n\n    .process-row.active .process-num-cell {\n      background: #ffffff;\n      color: var(--night);\n      border-color: #ffffff;\n      box-shadow: 0 0 14px rgba(255, 255, 255, 0.35);\n    }\n\n    .process-title {\n      font-size: calc(12.5 * var(--u));\n      font-weight: 600;\n      color: var(--ink-72);\n      letter-spacing: -0.01em;\n      transition: font-size 0.35s cubic-bezier(0.16, 1, 0.3, 1), color 0.35s ease;\n    }\n\n    .process-row.active .process-title {\n      font-size: calc(18 * var(--u));\n      color: var(--ink);\n    }\n\n    .process-body-wrapper {\n      display: grid;\n      grid-template-rows: 0fr;\n      transition: grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1);\n      overflow: hidden;\n      margin-left: calc(18 * var(--u));\n      padding-left: calc(26 * var(--u));\n      border-left: 1px solid var(--hairline);\n    }\n\n    .process-row.active .process-body-wrapper {\n      grid-template-rows: 1fr;\n    }\n\n    .process-body-content {\n      min-height: 0;\n      overflow: hidden;\n      padding-top: calc(8 * var(--u));\n      padding-bottom: calc(10 * var(--u));\n      font-size: calc(13 * var(--u));\n      line-height: 1.5;\n      color: var(--ink-72);\n      font-weight: 400;\n    }\n\n    /* Full-screen Loading Panel */\n    .loader-panel {\n      position: fixed;\n      inset: 0;\n      background-color: var(--night);\n      z-index: 1000;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.6s;\n    }\n\n    .loader-panel.hidden {\n      opacity: 0;\n      visibility: hidden;\n      pointer-events: none;\n    }\n\n    .loader-orb-wrap {\n      position: relative;\n      width: 240px;\n      height: 240px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    /* Ellipses */\n    .loader-ellipse-wide {\n      position: absolute;\n      width: 220px;\n      height: 120px;\n      border: 1.5px dashed rgba(63, 216, 255, 0.35);\n      border-radius: 50%;\n      transform: rotate(-25deg);\n      animation: orbitPulse 3.2s ease-in-out infinite alternate;\n    }\n\n    .loader-ellipse-circ {\n      position: absolute;\n      width: 170px;\n      height: 170px;\n      border: 1.5px dotted rgba(198, 255, 46, 0.35);\n      border-radius: 50%;\n      animation: orbitPulseCirc 4.5s linear infinite;\n    }\n\n    @keyframes orbitPulse {\n      0% { transform: rotate(-25deg) scale(0.96); opacity: 0.4; }\n      100% { transform: rotate(-20deg) scale(1.04); opacity: 0.9; }\n    }\n\n    @keyframes orbitPulseCirc {\n      0% { transform: rotate(0deg); }\n      100% { transform: rotate(360deg); }\n    }\n\n    /* Spinner mark */\n    .loader-mark {\n      position: relative;\n      width: 70px;\n      height: 70px;\n      animation: markSpin 1.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;\n    }\n\n    @keyframes markSpin {\n      0% { transform: rotate(0deg); }\n      100% { transform: rotate(360deg); }\n    }\n\n    .mark-ring {\n      position: absolute;\n      inset: 0;\n    }\n\n    .ring-sq {\n      position: absolute;\n      width: 9px;\n      height: 9px;\n      background: var(--cyan);\n      border-radius: 1.5px;\n      box-shadow: 0 0 8px var(--cyan);\n    }\n\n    .ring-sq:nth-child(1) { top: 2px; left: 30.5px; }\n    .ring-sq:nth-child(2) { top: 16px; right: 5px; }\n    .ring-sq:nth-child(3) { bottom: 16px; right: 5px; }\n    .ring-sq:nth-child(4) { bottom: 2px; left: 30.5px; }\n    .ring-sq:nth-child(5) { bottom: 16px; left: 5px; }\n    .ring-sq:nth-child(6) { top: 16px; left: 5px; }\n\n    .mark-chevron {\n      position: absolute;\n      top: 50%;\n      left: 50%;\n      width: 16px;\n      height: 16px;\n      transform: translate(-50%, -50%);\n      border-top: 3.5px solid var(--lime);\n      border-right: 3.5px solid var(--lime);\n      filter: drop-shadow(0 0 6px var(--lime));\n      transform: translate(-50%, -50%) rotate(45deg);\n    }\n\n    .loader-caption {\n      margin-top: 24px;\n      font-size: 11.5px;\n      font-weight: 600;\n      letter-spacing: 0.08em;\n      text-transform: uppercase;\n      color: var(--ink-72);\n    }\n\n    /* Reduced motion query */\n    @media (prefers-reduced-motion: reduce) {\n      .loader-ellipse-wide,\n      .loader-ellipse-circ,\n      .loader-mark {\n        animation: none !important;\n      }\n      .process-body-wrapper,\n      .process-title,\n      .process-num-cell,\n      .pill-btn {\n        transition: none !important;\n      }\n    }\n\n    /* Phone / Tablet responsive styles */\n    @media (max-width: 760px) {\n      :root {\n        --u: 1px;\n      }\n\n      .nav-bar {\n        height: 52px;\n        padding: 0 18px;\n      }\n\n      .nav-left {\n        display: none;\n      }\n\n      .nav-center {\n        position: static;\n        transform: none;\n        font-size: 18px;\n        flex: 1;\n      }\n\n      .nav-right {\n        gap: 8px;\n        flex: initial;\n      }\n\n      .pill-btn {\n        height: 34px;\n        padding: 0 14px;\n        font-size: 10px;\n      }\n\n      .hero-stage {\n        top: 96px;\n        padding: 0 20px;\n      }\n\n      .hero-headline {\n        font-size: clamp(38px, 11vw, 48px);\n        line-height: 1.02;\n        margin-bottom: 16px;\n      }\n\n      .hero-subline {\n        font-size: 15px;\n        line-height: 1.4;\n        max-width: 34ch;\n      }\n\n      .process-container {\n        left: 18px;\n        right: 18px;\n        width: auto;\n        bottom: 22px;\n        gap: 8px;\n      }\n\n      .process-num-cell {\n        width: 32px;\n        height: 32px;\n        font-size: 11px;\n      }\n\n      .process-title {\n        font-size: 12px;\n      }\n\n      .process-row.active .process-title {\n        font-size: 15px;\n      }\n\n      .process-body-content {\n        font-size: 12px;\n        line-height: 1.45;\n      }\n\n      .scroll-cue {\n        bottom: 24px;\n      }\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Fullscreen Loading Screen -->\n  <div class=\"loader-panel\" id=\"loader-panel\">\n    <div class=\"loader-orb-wrap\">\n      <div class=\"loader-ellipse-wide\"></div>\n      <div class=\"loader-ellipse-circ\"></div>\n      <div class=\"loader-mark\">\n        <div class=\"mark-ring\">\n          <div class=\"ring-sq\"></div>\n          <div class=\"ring-sq\"></div>\n          <div class=\"ring-sq\"></div>\n          <div class=\"ring-sq\"></div>\n          <div class=\"ring-sq\"></div>\n          <div class=\"ring-sq\"></div>\n        </div>\n        <div class=\"mark-chevron\"></div>\n      </div>\n    </div>\n    <div class=\"loader-caption\">Mobilizing Isometric City</div>\n  </div>\n\n  <!-- Navigation -->\n  <header class=\"nav-bar\">\n    <nav class=\"nav-left\">\n      <a class=\"nav-link\" href=\"#industries\">OUR INDUSTRIES</a>\n      <a class=\"nav-link\" href=\"#mission\">OUR MISSION</a>\n    </nav>\n    <div class=\"nav-center\">NORVA</div>\n    <div class=\"nav-right\">\n      <a class=\"pill-btn grey\" href=\"#apply\">APPLY</a>\n      <a class=\"pill-btn lime\" href=\"#request\">REQUEST CREWS</a>\n    </div>\n  </header>\n\n  <!-- Scroll Track & Sticky Scene -->\n  <main class=\"scroll-track\" id=\"scroll-track\">\n    <div class=\"viewport-stage\" id=\"viewport-stage\">\n      <!-- Video Element with desktop and mobile media queries -->\n      <video\n        class=\"scene-video\"\n        id=\"glide-video\"\n        playsinline\n        webkit-playsinline\n        muted\n        preload=\"auto\"\n        poster=\"https://d2ol7oe51mr4n9.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/33150b94-09f7-47da-a7c9-3ae76c2dd7eb.jpg\"\n      >\n        <source\n          media=\"(max-width: 900px)\"\n          src=\"https://d2ol7oe51mr4n9.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/9a30e5e9-9f03-4755-9bc1-7bcf1510aab3.mp4\"\n          type=\"video/mp4\"\n        />\n        <source\n          src=\"https://d2ol7oe51mr4n9.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/65fdef53-5686-4659-8761-52d61bf1a4f7.mp4\"\n          type=\"video/mp4\"\n        />\n      </video>\n\n      <!-- Gradient legibility shade -->\n      <div class=\"scene-shade\"></div>\n\n      <!-- Hero Copy -->\n      <section class=\"hero-stage\" id=\"hero-stage\">\n        <h1 class=\"hero-headline\">The New Standard<br>in Staffing</h1>\n        <p class=\"hero-subline\">\n          AI driven speed. Expert curation.<br>\n          We mobilize verified crews to protect your schedule and<br>\n          your bottom line in high-consequence environments.\n        </p>\n      </section>\n\n      <!-- Scroll Cue -->\n      <div class=\"scroll-cue\" id=\"scroll-cue\">\n        <div class=\"scroll-cue-text\">SCROLL TO DISCOVER OUR PROCESS</div>\n        <div class=\"scroll-cue-line-track\">\n          <div class=\"scroll-cue-line-fill\" id=\"scroll-cue-fill\"></div>\n        </div>\n      </div>\n\n      <!-- Process List -->\n      <aside class=\"process-container\" id=\"process-container\" aria-label=\"Process Steps\">\n        <!-- Row 01 -->\n        <div class=\"process-row active\" id=\"process-row-1\" data-step=\"1\">\n          <div class=\"process-header\">\n            <div class=\"process-num-cell\">01</div>\n            <div class=\"process-title\">Activation, simplified</div>\n          </div>\n          <div class=\"process-body-wrapper\">\n            <div class=\"process-body-content\">\n              One call starts mobilization. Craft, headcount and start date go straight to our vetted crews. No hand-offs. No escalations. Just boots on site within minutes.\n            </div>\n          </div>\n        </div>\n\n        <!-- Row 02 -->\n        <div class=\"process-row\" id=\"process-row-2\" data-step=\"2\">\n          <div class=\"process-header\">\n            <div class=\"process-num-cell\">02</div>\n            <div class=\"process-title\">Cleared to count</div>\n          </div>\n          <div class=\"process-body-wrapper\">\n            <div class=\"process-body-content\">\n              Every worker is screened before dispatch: compliance, background, certifications and fitness for duty, so the whole crew clears the gate on day one.\n            </div>\n          </div>\n        </div>\n\n        <!-- Row 03 -->\n        <div class=\"process-row\" id=\"process-row-3\" data-step=\"3\">\n          <div class=\"process-header\">\n            <div class=\"process-num-cell\">03</div>\n            <div class=\"process-title\">Proven field match</div>\n          </div>\n          <div class=\"process-body-wrapper\">\n            <div class=\"process-body-content\">\n              Skill-matrix verification pairs precision technical requirements with field-tested tradespeople, reducing turnover and friction across critical paths.\n            </div>\n          </div>\n        </div>\n\n        <!-- Row 04 -->\n        <div class=\"process-row\" id=\"process-row-4\" data-step=\"4\">\n          <div class=\"process-header\">\n            <div class=\"process-num-cell\">04</div>\n            <div class=\"process-title\">Seamless arrival</div>\n          </div>\n          <div class=\"process-body-wrapper\">\n            <div class=\"process-body-content\">\n              Real-time gate telemetry, digital badges, and dedicated on-site logistics ensure complete crew presence ready for immediate shift briefing.\n            </div>\n          </div>\n        </div>\n      </aside>\n    </div>\n  </main>\n\n  <script>\n    (function () {\n      \'use strict\';\n\n      // Elements\n      const track = document.getElementById(\'scroll-track\');\n      const video = document.getElementById(\'glide-video\');\n      const heroStage = document.getElementById(\'hero-stage\');\n      const scrollCue = document.getElementById(\'scroll-cue\');\n      const scrollCueFill = document.getElementById(\'scroll-cue-fill\');\n      const processContainer = document.getElementById(\'process-container\');\n      const loader = document.getElementById(\'loader-panel\');\n      const rows = [\n        document.getElementById(\'process-row-1\'),\n        document.getElementById(\'process-row-2\'),\n        document.getElementById(\'process-row-3\'),\n        document.getElementById(\'process-row-4\')\n      ];\n\n      // Update CSS viewport height helper\n      function updateVh() {\n        const vh = window.innerHeight * 0.01;\n        document.documentElement.style.setProperty(\'--vh\', `${vh}px`);\n      }\n      updateVh();\n      window.addEventListener(\'resize\', updateVh);\n\n      // Check URL search parameters for recorder mode\n      const urlParams = new URLSearchParams(window.location.search);\n      const isRecorder = urlParams.get(\'rec\') === \'1\';\n\n      // Fallback video duration\n      let videoDuration = 5.04;\n      if (video.duration && !isNaN(video.duration)) {\n        videoDuration = video.duration;\n      }\n      video.addEventListener(\'loadedmetadata\', function () {\n        if (video.duration && !isNaN(video.duration)) {\n          videoDuration = video.duration;\n        }\n      });\n\n      // Loader logic\n      let loaderDismissed = false;\n      function dismissLoader() {\n        if (loaderDismissed) return;\n        loaderDismissed = true;\n        if (loader) {\n          loader.classList.add(\'hidden\');\n          setTimeout(() => {\n            if (loader.parentNode) loader.parentNode.removeChild(loader);\n          }, 650);\n        }\n      }\n\n      if (isRecorder) {\n        dismissLoader();\n      } else {\n        // Video first frame loaded\n        video.addEventListener(\'loadeddata\', () => {\n          setTimeout(dismissLoader, 350);\n        });\n        video.addEventListener(\'canplay\', () => {\n          setTimeout(dismissLoader, 350);\n        });\n        // Max timeout fallback: 3.5s\n        setTimeout(dismissLoader, 3500);\n      }\n\n      // Easing function\n      function easeInOutQuad(t) {\n        return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;\n      }\n\n      function clamp(val, min, max) {\n        return Math.min(Math.max(val, min), max);\n      }\n\n      // State variables\n      let targetProgress = 0;\n      let smoothProgress = 0;\n      let targetTime = 0;\n      let currentTime = 0;\n      let isSeeking = false;\n      let pendingTime = null;\n\n      // Handle seeked events to ensure sharp, synchronized frame display\n      video.addEventListener(\'seeked\', () => {\n        isSeeking = false;\n        if (pendingTime !== null) {\n          const next = pendingTime;\n          pendingTime = null;\n          attemptSeek(next);\n        }\n      });\n\n      function attemptSeek(t) {\n        if (!video || isNaN(video.duration)) return;\n        const boundedTime = clamp(t, 0, videoDuration - 1 / 48);\n        if (isSeeking) {\n          pendingTime = boundedTime;\n        } else {\n          if (Math.abs(video.currentTime - boundedTime) > (1 / 60)) {\n            isSeeking = true;\n            try {\n              video.currentTime = boundedTime;\n            } catch (e) {\n              isSeeking = false;\n            }\n          }\n        }\n      }\n\n      // Pure function of p for UI state\n      function updateUI(p) {\n        // 1. Headline block:\n        // with h = easeInOutQuad(p / .38)\n        const tHeadline = clamp(p / 0.38, 0, 1);\n        const h = easeInOutQuad(tHeadline);\n        // apply translateY(-34h vh) rotateX(62h deg) scale(1 - .12h) around bottom edge\n        const vhVal = window.innerHeight * 0.01;\n        const translateY = -34 * h * vhVal;\n        const rotateX = 62 * h;\n        const scale = 1 - 0.12 * h;\n        heroStage.style.transform = `translateY(${translateY}px) rotateX(${rotateX}deg) scale(${scale})`;\n\n        // Opacity falls from 1 to 0 between p .10 and .24\n        let headlineOpacity = 1;\n        if (p <= 0.10) {\n          headlineOpacity = 1;\n        } else if (p >= 0.24) {\n          headlineOpacity = 0;\n        } else {\n          headlineOpacity = 1 - (p - 0.10) / (0.24 - 0.10);\n        }\n        heroStage.style.opacity = headlineOpacity;\n        heroStage.style.visibility = headlineOpacity <= 0.001 ? \'hidden\' : \'visible\';\n\n        // 2. Scroll cue:\n        // underline drains over the first 10%\n        const drain = clamp(1 - (p / 0.10), 0, 1);\n        scrollCueFill.style.transform = `scaleX(${drain})`;\n\n        // Cue fades out between p .04 and .12\n        let cueOpacity = 1;\n        if (p <= 0.04) {\n          cueOpacity = 1;\n        } else if (p >= 0.12) {\n          cueOpacity = 0;\n        } else {\n          cueOpacity = 1 - (p - 0.04) / (0.12 - 0.04);\n        }\n        scrollCue.style.opacity = cueOpacity;\n        scrollCue.style.visibility = cueOpacity <= 0.001 ? \'hidden\' : \'visible\';\n\n        // 3. Process list:\n        // rises 40px and fades in between p .08 and .24\n        let processOpacity = 0;\n        if (p <= 0.08) {\n          processOpacity = 0;\n        } else if (p >= 0.24) {\n          processOpacity = 1;\n        } else {\n          processOpacity = (p - 0.08) / (0.24 - 0.08);\n        }\n        const processTranslateY = (1 - processOpacity) * 40;\n        processContainer.style.opacity = processOpacity;\n        processContainer.style.transform = `translateY(${processTranslateY}px)`;\n        processContainer.style.visibility = processOpacity <= 0.001 ? \'hidden\' : \'visible\';\n\n        // Step 01 is active below p .62, and step 02 above it\n        const activeIndex = p < 0.62 ? 0 : 1;\n        rows.forEach((row, idx) => {\n          if (idx === activeIndex) {\n            row.classList.add(\'active\');\n          } else {\n            row.classList.remove(\'active\');\n          }\n        });\n      }\n\n      // Check reduced motion preference\n      const prefersReducedMotion = window.matchMedia(\'(prefers-reduced-motion: reduce)\').matches;\n\n      // Animation loop\n      function onFrame() {\n        if (!isRecorder) {\n          // Calculate raw scroll progress\n          const rect = track.getBoundingClientRect();\n          const totalScrollable = track.offsetHeight - window.innerHeight;\n          const currentScrolled = -rect.top;\n          const rawP = totalScrollable > 0 ? clamp(currentScrolled / totalScrollable, 0, 1) : 0;\n          targetProgress = rawP;\n\n          if (prefersReducedMotion) {\n            smoothProgress = targetProgress;\n            currentTime = targetProgress * (videoDuration - 1 / 48);\n          } else {\n            smoothProgress += (targetProgress - smoothProgress) * 0.2;\n            targetTime = smoothProgress * (videoDuration - 1 / 48);\n            currentTime += (targetTime - currentTime) * 0.2;\n          }\n\n          attemptSeek(currentTime);\n          updateUI(smoothProgress);\n        }\n\n        requestAnimationFrame(onFrame);\n      }\n      requestAnimationFrame(onFrame);\n\n      // Manual interaction with process items\n      rows.forEach((row, i) => {\n        row.addEventListener(\'click\', () => {\n          const targetP = i === 0 ? 0.35 : 0.75;\n          const totalScrollable = track.offsetHeight - window.innerHeight;\n          window.scrollTo({\n            top: targetP * totalScrollable,\n            behavior: prefersReducedMotion ? \'auto\' : \'smooth\'\n          });\n        });\n      });\n\n      // Recorder mode support (6.5 s animation driving p)\n      if (isRecorder) {\n        let startTime = performance.now();\n        const hold1 = 550; // 0.55s\n        const glide = 5040; // 5.04s\n        const total = 6500; // 6.5s\n\n        function recorderStep(now) {\n          const elapsed = now - startTime;\n          let p = 0;\n          if (elapsed <= hold1) {\n            p = 0;\n          } else if (elapsed <= hold1 + glide) {\n            p = (elapsed - hold1) / glide;\n          } else {\n            p = 1;\n          }\n          p = clamp(p, 0, 1);\n          const t = p * (videoDuration - 1 / 48);\n          if (video && !isNaN(video.duration)) {\n            try { video.currentTime = t; } catch (e) {}\n          }\n          updateUI(p);\n          if (elapsed < total) {\n            requestAnimationFrame(recorderStep);\n          }\n        }\n        requestAnimationFrame(recorderStep);\n      }\n\n      // Global helper for recorder API\n      window.__recTime = function (vid, t) {\n        const v = vid || video;\n        const dur = (v && v.duration && !isNaN(v.duration)) ? v.duration : videoDuration;\n        const p = clamp(t / (dur - 1 / 48), 0, 1);\n        const totalScrollable = track.offsetHeight - window.innerHeight;\n        window.scrollTo(0, p * totalScrollable);\n        if (v) {\n          try { v.currentTime = t; } catch (e) {}\n        }\n        updateUI(p);\n        return v ? v.currentTime : t;\n      };\n\n    })();\n  </script>\n</body>\n</html>\n"
        path {
          absolute_uri: "file:///app/src/main/assets/index.html"
        }
        overwrite: true
      }
    }
